class_name ReportTheme
extends RefCounted

static func css() -> String:
	return """
:root{--ink:#17324d;--muted:#576b80;--line:#d6e0e9;--paper:#fff;--wash:#f3f6fa;--blue:#2864a0;--good:#16796c;--bad:#b84242;--amber:#9a660f;color-scheme:light}
*{box-sizing:border-box}body{font-family:'Malgun Gothic','Apple SD Gothic Neo',sans-serif;margin:0 auto;max-width:1160px;color:var(--ink);background:var(--paper);padding:30px 24px 64px;line-height:1.65}
h1{font-size:27px;line-height:1.35;margin:8px 0 12px}h2{font-size:20px;margin:36px 0 14px;border-bottom:2px solid var(--line);padding-bottom:9px}h3{font-size:16px;margin:18px 0 8px}p{max-width:86ch;overflow-wrap:anywhere}.meta,.note,figcaption{color:var(--muted);font-size:13px}.note{line-height:1.8}
a{color:var(--blue);text-underline-offset:3px}a:focus-visible,button:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #88b9e9;outline-offset:3px}
button,.button,select{font:inherit;font-size:13px;line-height:1.5;border:1px solid #b5c8da;border-radius:5px;background:#f3f7fb;color:var(--ink);padding:8px 12px}button,.button{cursor:pointer}.button{display:inline-block;text-decoration:none}button:hover,.button:hover{background:#e7eff8}button:disabled{opacity:.45;cursor:default}.actions,.filters{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:14px 0}
table{border-collapse:collapse;font-size:13px;margin:10px 0;width:100%;font-variant-numeric:tabular-nums}th,td{border-bottom:1px solid var(--line);padding:8px 10px;text-align:right;vertical-align:top}th{background:#edf2f7;font-weight:600;white-space:nowrap}td:nth-child(2),td:nth-child(3){text-align:left}table.small{font-size:12px}.scroll{max-height:560px;overflow:auto;max-width:100%}.scroll td{white-space:nowrap}.table-wrap{overflow-x:auto;max-width:100%}
tr.penetration td{background:#f0f8f5}tr.non_penetration td{background:#fffaeb}tr.blocked td,tr.miss td{color:var(--muted)}.positive{color:var(--good)}.negative{color:var(--bad)}.mono{font-variant-numeric:tabular-nums}.badge{display:inline-block;font-size:12px;padding:3px 9px;border:1px solid var(--line);border-radius:4px;background:var(--wash)}
.tiles{display:flex;gap:12px;flex-wrap:wrap;margin:18px 0}.tile{border-left:4px solid var(--blue);padding:12px 16px;background:var(--wash);min-width:155px;flex:1}.tl{font-size:12px;color:var(--muted)}.tv{font-size:23px;font-weight:700;line-height:1.4}
.explanation{background:var(--wash);border-left:3px solid #a8bfd5;padding:14px 18px;margin:16px 0}.explanation p{margin:5px 0}.explanation li{margin:7px 0}details{border:1px solid var(--line);padding:12px 16px;margin:16px 0}summary{cursor:pointer;font-weight:600}
.sw,.legend i,.key i{display:inline-block;width:11px;height:11px;border-radius:2px;vertical-align:middle;margin-right:5px}.legend span,.key{display:inline-block;margin:4px 14px 4px 0;font-size:12px}svg.map{border:1px solid var(--line);max-width:100%;height:auto}.lbl{font-size:11px;fill:var(--ink);paint-order:stroke;stroke:#fff;stroke-width:3px}.chart{display:block;border:1px solid var(--line);background:#fff;max-width:100%;height:auto}.grid{stroke:#e6edf3}.zero{stroke:#9bafc1}.ax{font-size:11px;fill:#576b80}.ko{stroke:#8a9cae;stroke-dasharray:4 3}figure{margin:14px 0 22px;min-width:0}figcaption{padding:7px 2px;overflow-wrap:anywhere}.row{display:flex;gap:18px;flex-wrap:wrap}.row>figure{flex:1;min-width:min(300px,100%)}.impact-visual svg{display:block;width:100%;height:auto;border:1px solid var(--line)}
.dispersion-plots{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.dispersion-plots svg{display:block;width:100%;height:auto;background:#fbfcfe;border:1px solid var(--line)}.dispersion-summary{font-size:14px;font-weight:600}.density-legend{display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:var(--muted)}.density-legend i{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px}.report-nav{font-size:13px;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:20px}
@media(max-width:720px){body{padding:18px 12px 40px}h1{font-size:23px}h2{font-size:18px}.dispersion-plots{grid-template-columns:1fr}.tile{min-width:135px}.tv{font-size:20px}th,td{padding:6px 8px}.explanation{padding:12px}figure{margin:12px 0}.impact-visual{overflow-x:auto}.impact-visual svg{min-width:680px}}
@media print{body{max-width:none;padding:10px}.scroll{max-height:none;overflow:visible}.actions,.filters,.report-nav{display:none}details{break-inside:avoid}.dispersion-plots{grid-template-columns:repeat(2,minmax(0,1fr))}.impact-visual svg{min-width:0}}
"""
